# URL của backend API (ASP.NET Core)
# Ví dụ khi deploy backend lên Railway/Render/VPS:
# VITE_API_BASE_URL=https://your-backend.railway.app
#
# Để trống hoặc dùng /api khi chạy local (Vite proxy sẽ xử lý)
VITE_API_BASE_URL=

# Idle session policy (phút); giá trị không dương/không hợp lệ dùng fallback 60/2.
VITE_IDLE_TIMEOUT_MINUTES=60
VITE_IDLE_WARNING_MINUTES=2
