{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:source-ownership:unit": "vitest run --run tests/uiSourceOwnershipLeakage.test.ts",
    "test:source-ownership:e2e": "playwright test tests/ui-source-ownership.spec.ts",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:controls": "playwright test tests/control-surface.spec.ts",
    "test:ui-audit": "npm run test:ui-measurements",
    "test:ui-measurements": "playwright test tests/ui-audit.spec.ts --grep \"UI measurement audit\"",
    "test:ui-baseline": "playwright test tests/ui-audit.spec.ts --grep \"Phase 28 (login production-route baseline bridge|protected production-route ready cohort)\" --headed --workers=1 --output=test-results/playwright-phase28",
    "test:ui-dashboard-query": "playwright test tests/dashboard-production-query.spec.ts --headed --workers=1 --output=test-results/playwright-phase28-dashboard-query",
    "test:ui-approvals-query": "playwright test tests/approvals-production-query.spec.ts --headed --workers=1 --output=test-results/playwright-phase28-approvals-query",
    "test:ui-chef-dashboard-query": "playwright test tests/chef-dashboard-production-query.spec.ts --headed --workers=1 --output=test-results/playwright-phase28-chef-dashboard-query",
    "test:ui-meal-orders-query": "playwright test tests/meal-orders-production-query.spec.ts --headed --workers=1 --output=test-results/playwright-phase28-meal-orders-query",
    "test:ui-purchasing-query": "playwright test tests/purchasing-production-query.spec.ts --headed --workers=1 --output=test-results/playwright-phase28-purchasing-query",
    "test:ui-reports-query": "playwright test tests/reports-production-query.spec.ts --headed --workers=1 --output=test-results/playwright-phase28-reports-query",
    "test:ui-weekly-menu-query": "playwright test tests/weekly-menu-production-query.spec.ts --headed --workers=1 --output=test-results/playwright-phase28-weekly-menu-query",
    "test:ui-warehouse-query": "playwright test tests/warehouse-production-query.spec.ts --headed --workers=1 --output=test-results/playwright-phase28-warehouse-query",
    "test:ui-admin-data-query": "playwright test tests/admin-data-production-query.spec.ts --headed --workers=1 --output=test-results/playwright-phase28-admin-data-query",
    "test:ui-approval-rules-query": "playwright test tests/approval-rules-production-query.spec.ts --headed --workers=1 --output=test-results/playwright-phase28-approval-rules-query",
    "test:ui-static-form-baseline": "playwright test tests/static-form-production-route.spec.ts --headed --workers=1 --output=test-results/playwright-phase28-static-form",
    "test:ui-reconcile": "vitest run --run tests/uiAuditBaselineReconciliation.emit.test.ts --maxWorkers=1",
    "test:performance": "playwright test tests/navigation-performance.spec.ts tests/cache-navigation.spec.ts",
    "test:smoke": "playwright test tests/route-smoke.spec.ts",
    "test:visual": "playwright test tests/visual-routes.spec.ts tests/pagination-visual.spec.ts",
    "test:visual:update": "playwright test tests/visual-routes.spec.ts tests/pagination-visual.spec.ts --update-snapshots",
    "perf:load": "node scripts/perf-probe.mjs --load",
    "perf:inp": "node scripts/perf-probe.mjs --inp",
    "perf:overflow": "node scripts/perf-probe.mjs --overflow",
    "check:route-budgets": "node scripts/check-route-budgets.mjs",
    "check:workflow-api-boundary": "node scripts/check-workflow-api-boundary.mjs",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json --output-type err",
    "depcruise:baseline": "depcruise src --config .dependency-cruiser.cjs --output-type baseline > .dependency-cruiser-known-violations.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.17.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
