{
  "name": "ipcmanagement",
  "version": "1.0.0",
  "description": "Hệ thống quản lý bếp ăn công nghiệp (IPC Management System)",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "prepare": "husky",
    "fe": "npm run dev -w frontend",
    "be": "dotnet run --project backend/src/IPCManagement.Api",
    "build:be": "dotnet build backend/src/IPCManagement.Api/IPCManagement.Api.csproj",
    "gen:api:spec": "dotnet tool restore && dotnet build backend/src/IPCManagement.Api/IPCManagement.Api.csproj -c Release -p:UseAppHost=false -o .artifacts/contract-build/api && dotnet swagger tofile --output frontend/src/shared/api/contracts/openapi.json .artifacts/contract-build/api/IPCManagement.Api.dll v1",
    "gen:api": "npm run gen:api:spec && npx --yes openapi-typescript@7.13.0 frontend/src/shared/api/contracts/openapi.json --output frontend/src/shared/api/contracts/schema.ts --immutable --alphabetize",
    "check:api-contract": "npm run gen:api && git diff --exit-code -- frontend/src/shared/api/contracts/openapi.json frontend/src/shared/api/contracts/schema.ts",
    "test:be": "dotnet test backend/IPCManagement.slnx",
    "clean:coverage:be": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item -Recurse -Force backend/TestResults -ErrorAction SilentlyContinue\"",
    "test:be:coverage": "dotnet test backend/IPCManagement.slnx --settings backend/coverage.runsettings --collect:\"XPlat Code Coverage\" --results-directory backend/TestResults",
    "coverage:be:report": "dotnet tool run reportgenerator -reports:\"backend/TestResults/**/coverage.cobertura.xml\" -targetdir:\"backend/TestResults/CoverageReport\" -reporttypes:\"Html;TextSummary\"",
    "coverage:be": "npm run clean:coverage:be && npm run test:be:coverage && npm run coverage:be:report",
    "test:fe:unit": "npm run test:unit -w frontend",
    "coverage:fe": "npm run test:coverage -w frontend",
    "lint:fe": "npm run lint -w frontend",
    "depcruise:fe": "npm run depcruise -w frontend",
    "build:fe": "npm run build -w frontend",
    "check:architecture-growth": "node scripts/check-architecture-growth.mjs",
    "benchmark:workflow": "dotnet test backend/tests/IPCManagement.Api.Tests/IPCManagement.Api.Tests.csproj --filter \"Category=Performance\" --logger \"console;verbosity=normal\"",
    "verify": "npm run check:architecture-growth && npm run build:be && npm run test:be && npm run test:fe:unit && npm run lint:fe && npm run depcruise:fe && npm run build:fe",
    "verify:coverage": "npm run coverage:be && npm run coverage:fe",
    "e2e:happy": "powershell -ExecutionPolicy Bypass -File scripts/Invoke-Iter1HappyPathE2E.ps1",
    "e2e:weekly": "powershell -ExecutionPolicy Bypass -File scripts/Invoke-WeeklyHappyPathE2E.ps1",
    "e2e:exceptions": "powershell -ExecutionPolicy Bypass -File scripts/Invoke-Iter1ExceptionPathE2E.ps1",
    "commitlint": "commitlint --edit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Peaker04/IPCManagement.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Peaker04/IPCManagement/issues"
  },
  "homepage": "https://github.com/Peaker04/IPCManagement#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7"
  }
}
