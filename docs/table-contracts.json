{
  "version": 2,
  "sourceOfTruth": "docs/DOMAIN.md",
  "architecture": "3-Zone Flat Workbench",
  "contracts": [
    {
      "id": "admin-customers",
      "route": "/admin-data",
      "surface": "customers",
      "file": "frontend/src/features/admin/branches/AdminCustomersBranch.tsx",
      "type": "aggregate",
      "grain": "customer-contract-summary",
      "rowKey": "customerId",
      "owner": "CustomerContracts.GetCustomerContracts via AdminCustomersBranch filtered client page",
      "pagination": "scoped-snapshot",
      "primaryStatus": "customer-active"
    },
    {
      "id": "admin-bom",
      "route": "/admin-data",
      "surface": "bom",
      "file": "frontend/src/features/admin/branches/AdminBomBranch.tsx",
      "type": "aggregate",
      "grain": "dish-bom-coverage",
      "rowKey": "dishId",
      "owner": "DishCatalogDiagnostics.GetBomCoverage via AdminBomBranch filtered client page",
      "pagination": "scoped-snapshot",
      "primaryStatus": "bom-coverage"
    },
    {
      "id": "weekly-schedule",
      "route": "/weekly-menu",
      "surface": "schedule",
      "file": "frontend/src/features/weekly-menu/views/WeeklyScheduleView.tsx",
      "type": "matrix-grid",
      "grain": "dish-service-day",
      "rowKey": "dishLineId+serviceDay",
      "owner": "weekly-menu schedule model",
      "pagination": "scoped-snapshot",
      "primaryStatus": "draft"
    },
    {
      "id": "weekly-demand",
      "route": "/weekly-menu",
      "surface": "demand",
      "file": "frontend/src/features/weekly-menu/views/MaterialDemandView.tsx",
      "type": "action-queue",
      "grain": "service-date-material",
      "rowKey": "materialId+serviceDate",
      "owner": "weekly-menu demand model",
      "pagination": "scoped-snapshot",
      "primaryStatus": "procurement"
    },
    {
      "id": "weekly-production-plan",
      "route": "/weekly-menu",
      "surface": "production-plan",
      "file": "frontend/src/features/weekly-menu/views/ProductionPlanView.tsx",
      "type": "action-queue",
      "grain": "production-plan-dish",
      "rowKey": "planId+dishId",
      "owner": "weekly-menu production plan model",
      "pagination": "scoped-snapshot",
      "primaryStatus": "planned"
    },
    {
      "id": "weekly-cost",
      "route": "/weekly-menu",
      "surface": "cost",
      "file": "frontend/src/features/weekly-menu/views/MenuCostView.tsx",
      "type": "aggregate",
      "grain": "dish-material-cost",
      "rowKey": "dishId+materialId",
      "owner": "weekly-menu cost model",
      "pagination": "scoped-snapshot",
      "primaryStatus": "calculated"
    },
    {
      "id": "mrx-materials",
      "route": "/weekly-menu",
      "surface": "mrx-materials",
      "file": "frontend/src/features/weekly-menu/MrxQuantityInspectionPage.tsx",
      "type": "aggregate",
      "grain": "menu-version-ingredient-canonical-unit",
      "rowKey": "ingredientId+canonicalUnitId",
      "owner": "ReconciliationQuantityImportService.GetMaterialInspectionAsync canonical snapshot",
      "pagination": "server-page",
      "primaryStatus": "current-source-projection"
    },
    {
      "id": "mrx-plans",
      "route": "/weekly-menu",
      "surface": "mrx-plans",
      "file": "frontend/src/features/weekly-menu/MrxQuantityInspectionPage.tsx",
      "type": "action-queue",
      "grain": "menu-version-quantity-plan-line",
      "rowKey": "line.quantityPlanLineId",
      "owner": "ReconciliationQuantityImportService.GetPlanInspectionAsync canonical snapshot",
      "pagination": "server-page",
      "primaryStatus": "current-source-projection"
    },
    {
      "id": "dashboard-tasks",
      "route": "/",
      "surface": "tasks",
      "file": "frontend/src/features/dashboard/DashboardPage.tsx",
      "type": "action-queue",
      "grain": "operational-task",
      "rowKey": "taskId",
      "owner": "dashboard task model",
      "pagination": "scoped-snapshot",
      "primaryStatus": "pending"
    }
  ]
}
