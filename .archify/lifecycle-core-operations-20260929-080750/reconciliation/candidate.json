    {
      "dot": "cyan",
      "title": "Cross-module ownership",
      "items": [
        "Weekly-menu quantity import and BOM projection create the immutable DRAFT lines.",
        "Reconciliation services own READY, TRANSFERRED, dispositions, and completion.",
        "Inventory issue creation owns the normal TRANSFERRED to IN_PROGRESS transition and stock removal."
      ]
    },
    {
      "dot": "amber",
      "title": "Completion guards",
      "items": [
        "Current daily lineage requires WEEK_COMPLETE before batch completion.",
        "Legacy batches require linked issued quantities plus a reasoned disposition for every triggered variance.",
        "All mutation paths require operation-mode protection and optimistic version checks."
      ]
    },
    {
      "dot": "rose",
      "title": "Implementation ambiguity",
      "items": [
        "ReconciliationActualService also permits data entry while READY and changes the batch directly to IN_PROGRESS.",
        "That path bypasses the explicit TRANSFERRED warehouse handoff represented by the primary UI lifecycle.",
        "No cancellation or rollback state exists for a reconciliation batch in the persisted status constraint."
      ]
    }
  ]
